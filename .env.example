# WhatsApp Cloud API — https://developers.facebook.com/apps/
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_VERIFY_TOKEN=pick_any_secret_string_here

# Groq — https://console.groq.com (free tier, no card needed)
# Required for: AI conversations
GROQ_API_KEY=gsk_...

# OpenAI — https://platform.openai.com/api-keys
# Optional — only needed for Whisper voice transcription + TTS voice replies
OPENAI_API_KEY=sk-...
VOICE_REPLIES=false   # set true to reply with audio notes instead of text

# VAPI — https://dashboard.vapi.ai (AI phone calls)
VAPI_API_KEY=your_vapi_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here

# Resend — https://resend.com (email introductions)
RESEND_API_KEY=re_...
EMAIL_FROM_DOMAIN=really.ai   # must be verified in Resend

# Twilio — https://console.twilio.com/
# Required for: inbound/outbound phone calls
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+14155551234
PUBLIC_BASE_URL=https://your-ngrok-or-domain.com   # must be publicly reachable for Twilio callbacks

# App
DATABASE_URL=sqlite:///./really.db
DEBUG=false
