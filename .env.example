# Telegram Bot API — https://core.telegram.org/bots
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=pick_any_secret_string_here

# OpenAI — https://platform.openai.com/api-keys
# Required for: AI conversations + Whisper voice transcription + TTS voice replies
OPENAI_API_KEY=sk-...

# VAPI — https://dashboard.vapi.ai (AI phone calls)
VAPI_API_KEY=your_vapi_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here

# Resend — https://resend.com (email introductions)
RESEND_API_KEY=re_...
EMAIL_FROM_DOMAIN=really.ai   # must be verified in Resend

PUBLIC_BASE_URL=https://your-ngrok-or-domain.com   # must be publicly reachable for Telegram/VAPI webhooks
VOICE_REPLIES=false   # set true to reply with audio notes instead of text

# App
DATABASE_URL=sqlite:///./really.db
DEBUG=false
BOT_NAME=Really
BOT_PHONE_DISPLAY=Really AI

# Matching
MATCH_SCORE_THRESHOLD=0.6
MAX_MATCHES_PER_USER=5
